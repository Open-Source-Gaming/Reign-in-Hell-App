# Auto detect text files and perform LF normalization
* text=auto

# Text files that should have consistent LF line endings
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Source code
*.c text eol=lf
*.cc text eol=lf
*.cxx text eol=lf
*.cpp text eol=lf
*.c++ text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.h++ text eol=lf
*.hh text eol=lf
*.cs text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.go text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.php text eol=lf
*.rb text eol=lf
*.java text eol=lf
*.scala text eol=lf
*.sql text eol=lf
*.rs text eol=lf

# Documentation
*.txt text eol=lf
*.rtf text eol=lf
*.rst text eol=lf
*.adoc text eol=lf

