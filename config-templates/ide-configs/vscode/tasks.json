{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format Entire Project",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Format all files in the project using configured formatters",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Lint Entire Project",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$eslint-stylish"],
      "detail": "Lint all files in the project",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Fix Lint Issues",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint:fix"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$eslint-stylish"],
      "detail": "Automatically fix lint issues where possible",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Format Python Files",
      "type": "shell",
      "command": "black",
      "args": ["."],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Format all Python files using Black",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Lint Python Files",
      "type": "shell",
      "command": "ruff",
      "args": ["check", ".", "--fix"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Lint and fix Python files using Ruff",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}