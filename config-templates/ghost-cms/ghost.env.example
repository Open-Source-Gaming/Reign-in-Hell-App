# Public URL of your Ghost site.
GHOST_URL=http://localhost:8080

# Ghost Content API key (used by the SSG at build time).
GHOST_CONTENT_API_KEY=your-content-api-key-here

# MySQL credentials.
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_USER=ghost
MYSQL_PASSWORD=changeme-ghost
MYSQL_DATABASE=ghost

# Mailgun SMTP (for transactional emails: signup, password reset).
# Bulk newsletter API key is configured in Ghost Admin UI, not here.
MAIL_TRANSPORT=SMTP
MAIL_SERVICE=Mailgun
MAIL_USER=postmaster@mg.yourdomain.com
MAIL_PASS=your-mailgun-smtp-password
