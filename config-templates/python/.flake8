[flake8]
max-line-length = 88
extend-ignore =
    # E203: whitespace before ':'
    E203,
    # E501: line too long (handled by Black)
    E501,
    # W503: line break before binary operator
    W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg,
    build,
    dist,
    .tox,
    .mypy_cache,
    .pytest_cache,
    node_modules
per-file-ignores =
    # __init__.py files can have unused imports
    __init__.py:F401
    # Test files can have unused imports and redefined names
    test_*.py:F401,F811
    # Settings files can have wildcard imports
    settings.py:F401,F403
    # Migration files generated by frameworks
    */migrations/*.py:F401,F403,F405
select = E,W,F,C
doctests = True